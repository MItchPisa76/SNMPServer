<% 
const info = mfp.datainfo || {}; 
const modello = info['1.3.6.1.4.1.236.11.5.1.1.1.1.0'] || info['1.3.6.1.2.1.1.5.0'] || 'Modello Sconosciuto'; 
const statoOnline = info['mtc.offline'] || 'N/D'; 
const isOnline = statoOnline.startsWith('ONLINE'); 
%>

<div class="card mb-4 border shadow-sm">
    <!-- Header Stampante -->
    <div class="card-header d-flex justify-content-between align-items-center cursor-pointer <%= isOnline ? 'bg-success-subtle' : 'bg-danger-subtle' %>"
        data-bs-toggle="collapse"
        data-bs-target="#collapse-mfp-<%= mfp.serial %>"
        aria-expanded="false" style="cursor: pointer;">

        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-chevron-down toggle-icon"></i>
            <strong><%= modello %></strong>
            <span class="text-muted small">(S/N: <code><%= mfp.serial %></code> | IPv4: <code><%= mfp.ipv4 %></code>)</span>
        </div>

        <div>
            <span class="badge <%= isOnline ? 'bg-success' : 'bg-danger' %>"><%= statoOnline %></span>
        </div>
    </div>

    <!-- Contenuto Collassabile -->
    <div id="collapse-mfp-<%= mfp.serial %>" class="collapse">
        <div class="card-body">
            <ul class="nav nav-tabs mb-3" id="mfpTab-<%= mfp.serial %>" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active small py-2 fw-bold" id="status-tab-<%= mfp.serial %>" data-bs-toggle="tab" data-bs-target="#status-pane-<%= mfp.serial %>" type="button" role="tab">
                        <i class="bi bi-speedometer2"></i> Stato & Consumabili
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link small py-2 fw-bold" id="info-tab-<%= mfp.serial %>" data-bs-toggle="tab" data-bs-target="#info-pane-<%= mfp.serial %>" type="button" role="tab">
                        <i class="bi bi-info-circle"></i> Info Dispositivo
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link small py-2 fw-bold" id="queryoids-tab-<%= mfp.serial %>" data-bs-toggle="tab" data-bs-target="#queryoids-pane-<%= mfp.serial %>" type="button" role="tab">
                        <i class="bi bi-search"></i> Query OIDs
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="mfpTabContent-<%= mfp.serial %>">
                <%- include('mfp-tab-status', { mfp: mfp }) %>
                <%- include('mfp-tab-info', { mfp: mfp }) %>
                
               
            </div>
        </div>
    </div>
</div>