<% const info=mfp.datainfo || {}; mfp.serial=mfp.serial.replaceAll(" ", "");

console.log(mfp)%>
<% let modello=info['1.3.6.1.4.1.236.11.5.1.1.1.1.0'] || info['1.3.6.1.2.1.1.5.0']; %>
<% if (modello !=null) modello=modello.value; else modello='Modello Sconosciuto' ; %>
<% const statoOnline=info['mtc.offline']!=null? (info['mtc.offline'].value || 'N/D' ):" NULL"; %>
    <% const isOnline=statoOnline.startsWith('ONLINE'); %>

        <div class="card mb-4 border shadow-sm">
            <!-- Header Stampante -->
            <div class="card-header d-flex justify-content-between align-items-center cursor-pointer <%= isOnline ? 'bg-success-subtle' : 'bg-danger-subtle' %>"
                data-bs-toggle="collapse" data-bs-target="#collapse-mfp-<%= mfp.serial %>" aria-expanded="false"
                style="cursor: pointer;">

                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-chevron-down toggle-icon"></i>
                    <strong>
                        <%= modello %>
                    </strong>
                    <span class="text-muted small">(S/N: <code><%= mfp.serial %></code> | IPv4:
                        <code><%= mfp.ipv4 %></code>)</span>
                </div>

                <div>
                    <span id="mfp-online-<%= mfp.serial %>" class="badge <%= isOnline ? 'bg-success' : 'bg-danger' %>">
                        <%= statoOnline %>
                    </span>
                </div>
            </div>

            <!-- Contenuto Collassabile -->
            <div id="collapse-mfp-<%= mfp.serial%>" class="collapse">
                <div class="card-body">
                    <!-- Navigation Tabs -->
                    <ul class="nav nav-tabs mb-3" id="mfp-tab-<%= mfp.serial %>" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link small py-2 fw-bold" id="info-tab-<%= mfp.serial %>"
                                data-bs-toggle="tab" data-bs-target="#info-pane-<%= mfp.serial %>" type="button"
                                role="tab" aria-controls="info-pane-<%= mfp.serial %>" aria-selected="false">
                                <i class="bi bi-info-circle"></i> Info Dispositivo
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active small py-2 fw-bold" id="status-tab-<%= mfp.serial %>"
                                data-bs-toggle="tab" data-bs-target="#status-pane-<%= mfp.serial %>" type="button"
                                role="tab" aria-controls="status-pane-<%= mfp.serial %>" aria-selected="true">
                                <i class="bi bi-speedometer2"></i> Stato & Consumabili
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link small py-2 fw-bold" id="queryoids-tab-<%= mfp.serial %>"
                                data-bs-toggle="tab" data-bs-target="#queryoids-pane-<%= mfp.serial %>" type="button"
                                role="tab" aria-controls="queryoids-pane-<%= mfp.serial %>" aria-selected="false">
                                <i class="bi bi-search"></i> Query OIDs
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="mfp-tab-content-<%= mfp.serial %>">
                        <!-- Tab 1: Info Dispositivo -->
                        <div class="tab-pane fade" id="info-pane-<%= mfp.serial %>" role="tabpanel"
                            aria-labelledby="info-tab-<%= mfp.serial %>">
                            <%- include('mfp-tab-info', { mfp: mfp }); %>
                        </div>

                        <!-- Tab 2: Stato & Consumabili (Inizialmente Attiva) -->
                        <%- include('mfp-tab-status', { mfp: mfp }); %>

                            <!-- Tab 3: Query OIDs -->
                            <div class="tab-pane fade" id="queryoids-pane-<%= mfp.serial %>" role="tabpanel"
                                aria-labelledby="queryoids-tab-<%= mfp.serial %>">
                                <%- include('mfp-queryoids.ejs', { }); %>
                            </div>
                    </div>
                </div>
            </div>
        </div>