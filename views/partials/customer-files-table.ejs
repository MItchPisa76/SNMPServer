<div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0 customer-files-table" style="font-size: 0.875rem;">
        <thead class="table-secondary">
            <tr>
                <th scope="col">Versione</th>
                <th scope="col">Tag / File</th>
                <th scope="col">S.O.</th>
                <th scope="col" class="text-end">Download</th>
            </tr>
        </thead>
        <tbody class="files-table-body">
            <% if (customer.downloadedFiles && customer.downloadedFiles.length > 0) { %>
                <% customer.downloadedFiles.forEach(file => { %>
                    <tr>
                        <td><span class="badge bg-primary"><%= file.version %></span></td>
                        <td class="text-truncate" style="max-width: 180px;" title="<%= file.fileName %>">
                            <i class="bi bi-file-earmark-zip text-secondary me-1"></i><%= file.fileName %>
                        </td>
                        <td><span class="badge bg-secondary"><%= file.so || 'Unknown' %></span></td>
                        <td class="text-end">
                            <a href="/api/github/downloads/<%= encodeURIComponent(customer.name) %>/<%= encodeURIComponent(file.version) %>/<%= encodeURIComponent(file.fileName) %>" 
                               class="btn btn-sm btn-outline-success py-0 px-2" download>
                                <i class="bi bi-download"></i> Scarica
                            </a>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="4" class="text-center text-muted py-2">
                        Nessun file scaricato disponibile.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>