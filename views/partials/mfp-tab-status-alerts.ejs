<h6 class="fw-bold">Alert & Notifiche</h6>

<% let hasAlerts=false; if (mfp.dataalerts) { Object.keys(mfp.dataalerts).forEach(aKey=> {%>
   
    <%
    const alert = mfp.dataalerts[aKey];
    if (alert.description && alert.description.trim() !== '') {
    hasAlerts = true; %>
    <div class="alert alert-warning p-2 small mb-2">
        <i class="bi bi-exclamation-triangle-fill text-danger"></i>
        <strong>Livelloaa <%= alert.severity %>:</strong>
        <%= alert.description %>
            <div class="text-muted mt-1" style="font-size: 10px;">Attivo da: <%= alert.time %>
            </div>
    </div>
    <% } }); } if (!hasAlerts) { %>
        <div class="alert alert-light border p-2 text-success small mb-0">
            <i class="bi bi-check-circle-fill"></i> Nessun alert attivo.
        </div>
        <% } %>