<div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="fw-bold mb-0"><i class="bi bi-search"></i> Gestione e Configurazione OIDs (Database)</h6>
    <span class="querylist" data-serial="<%= mfp.serial %>">
        <%- include('mfp-queryoids-activequeries.ejs',{items:[]}) %>
    </span>
    <span class="text-muted small">Modifica i parametri e salva direttamente la riga</span>
</div>

<div class="table-responsive">
    <table class="table table-sm table-hover table-striped border align-middle serial-base"
        data-serial="<%= mfp.serial %>">
        <thead class="table-light">
            <tr>
                <th style="width: 15%;">OID</th>
                <th style="width: 12%;">Short</th>
                <th style="width: 12%;">Brand Short</th>
                <th style="width: 25%;">Descrizione</th>
                <th style="width: 20%;">Vendor</th>
                <th style="width: 20%;">Origin</th>
                <th style="width: 7%;">Priority</th>
                <th style="width: 8%;">Mode</th>
                <th style="width: 21%;" class="text-end">Azioni</th>
            </tr>
            <!-- Riga iniziale per l'INSERIMENTO / RICHIESTA di un OID -->
            <tr class="table-warning bg-opacity-25 row-new-oid">
                <td><input type="text" data-target="oid" class="form-control form-control-sm f-oid"
                        placeholder="Es. 1.3.6.1..."></td>
                <td><input type="text" data-target="short" class="form-control form-control-sm f-short"
                        placeholder="short"></td>
                <td><input type="text" data-target="brandShort" class="form-control form-control-sm f-brandShort"
                        placeholder="brand"></td>
                <td><input type="text" data-target="descrizione" class="form-control form-control-sm f-descrizione"
                        placeholder="Descrizione OID"></td>
                <td><input type="text" data-target="vendor" class="form-control form-control-sm f-vendor"
                        placeholder="Vendor"></td>
                <td><label data-target="origin" class="form-control form-control-sm f-priority" placeholder="Origin"
                        value="nope"></td>
                <td><input type="number" class="form-control form-control-sm f-priority" value="-1"></td>

                <td class="text-center align-middle">
                    <div class="d-flex justify-content-center gap-3">
                        <div class="form-check" title="Bit 1 (& 1)">
                            <input class="form-check-input f-mode-bit1" type="checkbox">
                            <label class="form-check-label small">force</label>
                        </div>
                        <div class="form-check" title="Bit 2 (& 2)">
                            <input class="form-check-input f-mode-bit2" type="checkbox">
                            <label class="form-check-label small">walk</label>
                        </div>
                    </div>
                </td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-warning btn-request-oid" data-command="get"
                            title="Richiedi get OID al client">
                            <i class="bi bi-send"></i> Get
                        </button>
                        <button class="btn btn-warning btn-request-oid" data-command="walk"
                            title="Richiedi Walk OID al client">
                            <i class="bi bi-send"></i> Walk
                        </button>
                        <button class="btn btn-primary btn-create-oid" title="Aggiungi nuovo OID" disabled>
                            <i class="bi bi-plus-lg"></i> Aggiungi
                        </button>
                    </div>
                </td>
            </tr>
        </thead>
        <tbody>
            <%- include('mfp-queryoids-table.ejs', { oidsList: [] }); %>
        </tbody>
        <tfoot class="table-light table-paginator">
            <tr>
                <td colspan="5">
                    <div class="d-flex flex-wrap justify-content-between align-items-center py-2 gap-2">

                        <!-- 1. Gruppo Navigazione (Prima & Precedente) -->
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary" data-action="first"
                                title="Prima Pagina">
                                <i class="bi bi-chevron-double-left"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" data-action="prev"
                                title="Pagina Precedente">
                                <i class="bi bi-chevron-left"></i> Prec
                            </button>
                        </div>

                        <!-- 2. Centro: Contatore / Input Modificabile per Pagina o Elementi -->
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted">Da</span>
                            <input type="number" data-action="from" class="form-control form-control-sm text-center"
                                style="width: 65px;" min="1" value="0" title="Inserisci numero pagina e premi Invio">
                            <span class="small text-muted"> conta </span>
                            <input type="number" data-action="count" class="form-control form-control-sm text-center"
                                style="width: 65px;" min="1" value="10" title="Inserisci numero pagina e premi Invio">
                        </div>

                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary" data-action="next"
                                title="Pagina Successiva">
                                Succ <i class="bi bi-chevron-right"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary" data-action="last"
                                title="Ultima Pagina">
                                <i class="bi bi-chevron-double-right"></i>
                            </button>
                        </div>

                    </div>
                </td>
            </tr>
        </tfoot>
    </table>
</div>