<div class="row mb-4 bg-body-tertiary p-3 rounded mx-0 align-items-center">
  <div class="col-12 mb-2">
    <h6 class="text-uppercase text-muted fw-bold mb-0" style="font-size: 0.75rem;">
      <i class="bi bi-robot"></i> Gestione Comandi Crawler Host
    </h6>
  </div>

  <%  console.log(host);
  function getStatus(val) { 
    console.log("******************");
    console.log(val);
    if (!val) return 'OFF' ; 
    const normalized=String(val).toLowerCase().trim(); 
    if (normalized==='true' || normalized==='on' ) return 'ON' ; 
    if (normalized==='once' ) return 'ONCE' ; 
    if (normalized==='send.once' ) return 'ONCE' ; 
    if (normalized==='running.once' ) return 'ONCE' ; 
    if (normalized==='running.true' ) return 'ON' ; return 'OFF' ; } %>

  <div class="col-md-12 d-flex flex-wrap gap-3 align-items-center">




    <div class="d-flex align-items-center bg-white p-2 rounded border">
      <span class="me-2 small fw-bold">Reset Host:</span>
      <div class="btn-group btn-group-sm" role="group">
        <button type="button" class="btn crawler-btn btn-outline-secondary" data-token="<%= host.token %>" data-action="resetHost" data-value="send.reset">RESET</button>
      </div>
    </div>



    <!-- Find New Hosts -->
    <% let stFind=getStatus(host.crawler ? host.crawler.findNewHosts.status : null); %>


    <div class="d-flex align-items-center bg-white p-2 rounded border"  title="*<%= host.crawler.findNewHosts.status %>">
      <span class="me-2 small fw-bold" data-toggle="tooltip" title="<%= host.crawler.findNewHosts.status%>">Find New Hosts:</span>
      <div class="btn-group btn-group-sm" role="group" >
        <button type="button" class="btn crawler-btn <%= stFind === 'ON' ? 'btn-success active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="findNewHosts" data-value="send.true">ON</button>
        <button type="button" class="btn crawler-btn <%= stFind === 'OFF' ? 'btn-secondary active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="findNewHosts" data-value="send.off">OFF</button>
        <button type="button" class="btn crawler-btn <%= stFind === 'ONCE' ? 'btn-info text-white active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="findNewHosts" data-value="send.once">ONCE <%=host.crawler ? host.crawler.findNewHosts.progress : "off" %> </button>
      </div>
    </div>

    <!-- Force Resend -->
    <% let stForce=getStatus(host.crawler.forceResend ? host.crawler.forceResend.status : null); %>
    <div class="d-flex align-items-center bg-white p-2 rounded border">
      <span class="me-2 small fw-bold">Force Resend:</span>
      <div class="btn-group btn-group-sm" role="group">
        <button type="button" class="btn crawler-btn <%= stForce === 'ON' ? 'btn-success active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="forceResend" data-value="true">ON</button>
        <button type="button" class="btn crawler-btn <%= stForce === 'OFF' ? 'btn-secondary active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="forceResend" data-value="false">OFF</button>
        <button type="button" class="btn crawler-btn <%= stForce === 'ONCE' ? 'btn-info text-white active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="forceResend" data-value="once">ONCE</button>
      </div>
    </div>

    <!-- Refresh VALUES -->
    <% let stOid=getStatus(host.crawler.refreshvalues ? host.crawler.refreshvalues.status : null); %>
    <div class="d-flex align-items-center bg-white p-2 rounded border">
      <span class="me-2 small fw-bold">Values:</span>
      <div class="btn-group btn-group-sm" role="group">
        <button type="button" class="btn crawler-btn <%= stOid === 'ON' ? 'btn-success active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="refreshvalues" data-value="send.true">ON</button>
        <button type="button" class="btn crawler-btn <%= stOid === 'OFF' ? 'btn-secondary active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="refreshvalues" data-value="send.off">OFF</button>
        <button type="button" class="btn crawler-btn <%= stOid === 'ONCE' ? 'btn-info text-white active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="refreshvalues" data-value="send.once">ONCE</button>
      </div>
    </div>

    <!-- Refresh OIDs -->
    <% stOid=getStatus(host.crawler ? host.crawler.refreshoids.status : null); %>
    <div class="d-flex align-items-center bg-white p-2 rounded border">
      <span class="me-2 small fw-bold"  data-toggle="tooltip" title="<%= host.crawler.refreshoids.status%>">OIDs:</span>
      <div class="btn-group btn-group-sm" role="group" title = "<%= host.crawler.refreshoids.status%>">
        <button type="button" class="btn crawler-btn <%= stOid === 'ON' ? 'btn-success active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="refreshoids" data-value="send.true">ON</button>
        <button type="button" class="btn crawler-btn <%= stOid === 'OFF' ? 'btn-secondary active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="refreshoids" data-value="send.off">OFF</button>
        <button type="button" class="btn crawler-btn <%= stOid === 'ONCE' ? 'btn-info text-white active' : 'btn-outline-secondary' %>" data-token="<%= host.token %>" data-action="refreshoids" data-value="send.once">ONCE</button>
      </div>
    </div>
  </div>
</div>