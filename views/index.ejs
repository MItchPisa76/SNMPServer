<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoraggio Host & MFP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .progress-thin {
            height: 18px;
            font-size: 11px;
            font-weight: bold;
        }

        .token-truncate {
            max-width: 140px;
            text-overflow: ellipsis;
            overflow: hidden;
            white-space: nowrap;
        }

        .card-header .toggle-icon {
            transition: transform 0.2s ease-in-out;
            transform: rotate(-90deg);
        }

        .card-header.collapsed .toggle-icon {
            transform: rotate(0deg);
        }

        .nav-tabs .nav-link {
            font-weight: 500;
            border: none;
            border-bottom: 3px solid transparent;
            color: #6c757d;
        }

        .nav-tabs .nav-link.active {
            color: #0d6efd;
            border-bottom-color: #0d6efd;
            background: transparent;
        }

        .customer-section {
            border-left: 4px solid #0d6efd;
            padding-left: 15px;
        }

        .host-section {
            background-color: #f8f9fa;
            border-left: 3px solid #6c757d;
            padding-left: 12px;
            margin-top: 15px;
        }
    </style>
</head>

<body class="bg-light p-3 p-md-5">

    <div class="container-fluid">
        <h1 class="mb-4"><i class="bi bi-cpu-fill"></i> Monitoraggio Host e Dispositivi MFP</h1>
        
        <!-- BARRA REFRESH GLOBALE -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border gap-3">
            <!-- Lato Sinistro: Pulsante Manuale & Status -->
            <div class="d-flex align-items-center gap-3">
                <button id="btn-refresh-global" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-repeat" id="refresh-icon"></i> Aggiorna Ora
                </button>

                <span id="global-refresh-status" class="badge bg-success-subtle text-success border">
                    <i class="bi bi-check-circle-fill"></i> Pronto
                </span>

                <span id="last-update-time" class="text-muted small border-start ps-3">
                    Ultimo aggiornamento: In attesa...
                </span>
            </div>

            <!-- Lato Destro: Configurazione Auto-Refresh -->
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-muted"></i>
                <label for="auto-refresh-select" class="form-label mb-0 small fw-bold">Auto-Refresh:</label>
                <select id="auto-refresh-select" class="form-select form-select-sm" style="width: auto;">
                    <option value="0">Disattivato</option>
                    <option value="1">Ogni secondo</option>
                    <option value="10">Ogni 10 secondi</option>
                    <option value="30" selected>Ogni 30 secondi</option>
                    <option value="60">Ogni 1 minuto</option>
                    <option value="300">Ogni 5 minuti</option>
                </select>
            </div>
        </div>

        <!-- TAB NAVIGATION -->
        <ul class="nav nav-tabs mb-4" id="mainTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="customers-tab" data-bs-toggle="tab" data-bs-target="#customers-content" type="button" role="tab" aria-controls="customers-content" aria-selected="true">
                    <i class="bi bi-people-fill"></i> Clienti
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="hosts-tab" data-bs-toggle="tab" data-bs-target="#hosts-content" type="button" role="tab" aria-controls="hosts-content" aria-selected="false">
                    <i class="bi bi-server"></i> Host
                </button>
            </li>
        </ul>

        <!-- TAB CONTENTS -->
        <div class="tab-content" id="mainTabContent">
            
            <!-- TAB 1: CUSTOMERS WITH THEIR HOSTS & DATI -->
            <div class="tab-pane fade show active" id="customers-content" role="tabpanel" aria-labelledby="customers-tab">
                <% if (!customers || customers.length===0) { %>
                    <div class="alert alert-warning">Nessun cliente trovato nel sistema.</div>
                <% } else { %>
                    <% customers.forEach((customer)=> { %>
                        <div class="card mb-4 shadow-sm border-0">
                            <!-- CUSTOMER HEADER -->
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <h4 class="mb-0">
                                        <i class="bi bi-person-badge-fill"></i>
                                        <%= customer.name %>
                                    </h4>
                                    <small class="text-white-50">
                                        Token: <code><%= customer.tokenI %></code>
                                    </small>
                                </div>
                                <div class="d-flex gap-3">
                                    <span class="badge bg-light text-primary">
                                        <%= customer.hosts ? customer.hosts.length : 0 %> Host
                                    </span>
                                    <span class="badge bg-light text-success">
                                        <%= customer.dati ? customer.dati.length : 0 %> MFP
                                    </span>
                                </div>
                            </div>

                            <div class="card-body">
                                <!-- HOSTS SECTION FOR THIS CUSTOMER -->
                                <div class="customer-section">
                                    <h5 class="mb-3"><i class="bi bi-server"></i> Host Registrati</h5>

                                    <% if (!customer.hosts || customer.hosts.length===0) { %>
                                        <div class="alert alert-info mb-3">Nessun host registrato per questo cliente.</div>
                                    <% } else { %>
                                        <% customer.hosts.forEach((host)=> { %>
                                            <div class="host-section p-3 rounded mb-3">
                                                <!-- HOST HEADER -->
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <div>
                                                        <h6 class="mb-0 text-dark">
                                                            <i class="bi bi-server"></i>
                                                            <%= host.hostname || 'Host Sconosciuto' %>
                                                        </h6>
                                                        <small class="text-muted">
                                                            <% try { const ipv4 = JSON.parse(host.IPV4); %>
                                                                IP: <code><%= ipv4[0] ? ipv4[0].localIPv4 : 'N/D' %></code>
                                                                <%= (ipv4 && ipv4[0].localIF) ? `(${ipv4[0].localIF})` : '' %>
                                                            <% } catch(e) { %>
                                                                IP: N/D
                                                            <% } %>
                                                        </small>
                                                    </div>
                                                    <span class="badge bg-secondary token-truncate" title="<%= host.token %>">
                                                        <%= host.token %>
                                                    </span>
                                                </div>

                                                <!-- CRAWLER CONTROLS FOR THIS HOST -->
                                                <%- include('partials/crawler-controls', { host: host }) %>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>

                                <!-- DATI/MFP SECTION FOR THIS CUSTOMER -->
                                <div class="customer-section mt-4">
                                    <h5 class="mb-3"><i class="bi bi-printer-fill"></i> Dispositivi MFP (<%= customer.dati ? customer.dati.length : 0 %>)</h5>

                                    <% if (!customer.dati || customer.dati.length===0) { %>
                                        <div class="alert alert-info mb-0">Nessun dispositivo MFP registrato per questo cliente.</div>
                                    <% } else { %>
                                        <% customer.dati.forEach((mfp)=> { %>
                                            <%- include('partials/mfp-card', { mfp: mfp, customer: customer }) %>
                                        <% }); %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <!-- TAB 2: ALL HOSTS -->
            <div class="tab-pane fade" id="hosts-content" role="tabpanel" aria-labelledby="hosts-tab">
                <% if (!hosts || hosts.length===0) { %>
                    <div class="alert alert-warning">Nessun host trovato nel sistema.</div>
                <% } else { %>
                    <% hosts.forEach((host)=> { %>
                        <div class="card mb-4 shadow-sm border-0">

                            <!-- HEADER HOST -->
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <h4 class="mb-0 text-warning">
                                        <i class="bi bi-server"></i>
                                        <%= host.hostname || 'Host Sconosciuto' %>
                                    </h4>
                                    <small class="text-white-50">
                                        <% try { const ipv4 = JSON.parse(host.IPV4); %>
                                            IP: <code><%= ipv4[0] ? ipv4[0].localIPv4 : 'N/D' %></code>
                                            <%= (ipv4 && ipv4[0].localIF) ? `(${ipv4[0].localIF})` : '' %>
                                        <% } catch(e) { %>
                                            IP: N/D
                                        <% } %>
                                    </small>
                                </div>
                                <div>
                                    <span class="badge bg-secondary token-truncate d-inline-block" title="<%= host.token %>">
                                        Token: <%= host.token %>
                                    </span>
                                </div>
                            </div>

                            <div class="card-body">
                                <!-- CONTROLLI CRAWLER -->
                                <%- include('partials/crawler-controls', { host: host }) %>

                                <!-- LISTA STAMPANTE MFP PER HOST -->
                                <h5 class="mt-4 mb-3"><i class="bi bi-printer-fill"></i> Stampanti Interrogate (<%=
                                        host.dati ? host.dati.length : 0 %>)</h5>

                                <% if (!host.dati || host.dati.length===0) { %>
                                    <div class="alert alert-info mb-0">Nessuna MFP registrata o dati non ancora acquisiti per questo host.</div>
                                <% } else { %>
                                    <% host.dati.forEach((mfp)=> { %>
                                        <%- include('partials/mfp-card', { mfp: mfp, host: host }) %>
                                    <% }); %>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>

</html>
