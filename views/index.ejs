<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monitoraggio Host & MFP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .progress-thin {
            height: 18px;
            font-size: 11px;
            font-weight: bold;
        }

        .token-truncate {
            max-width: 140px;
            text-overflow: ellipsis;
            overflow: hidden;
            white-space: nowrap;
        }

        .card-header .toggle-icon {
            transition: transform 0.2s ease-in-out;
            transform: rotate(-90deg);
        }

        .card-header.collapsed .toggle-icon {
            transform: rotate(0deg);
        }

        .nav-tabs .nav-link {
            font-weight: 500;
            border: none;
            border-bottom: 3px solid transparent;
            color: #6c757d;
        }

        .nav-tabs .nav-link.active {
            color: #0d6efd;
            border-bottom-color: #0d6efd;
            background: transparent;
        }

        .customer-section {
            border-left: 4px solid #0d6efd;
            padding-left: 15px;
        }

        .host-section {
            background-color: #f8f9fa;
            border-left: 3px solid #6c757d;
            padding-left: 12px;
            margin-top: 15px;
        }
    </style>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/github-panel.js"></script>
    <script src="/js/main.js"></script>
</head>

<body class="bg-light p-3 p-md-5">

    <div class="container-fluid">
        <h1 class="mb-4"><i class="bi bi-cpu-fill"></i> Monitoraggio Host e Dispositivi MFP</h1>

        <!-- BARRA REFRESH GLOBALE -->
        <div
            class="d-flex flex-wrap justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border gap-3">
            <div class="d-flex align-items-center gap-3">
                <button id="btn-refresh-global" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-repeat" id="refresh-icon"></i> Aggiorna Ora
                </button>

                <span id="global-refresh-status" class="badge bg-success-subtle text-success border">
                    <i class="bi bi-check-circle-fill"></i> Pronto
                </span>

                <span id="last-update-time" class="text-muted small border-start ps-3">
                    Ultimo aggiornamento: In attesa...
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-muted"></i>
                <label for="auto-refresh-select" class="form-label mb-0 small fw-bold">Auto-Refresh:</label>
                <select id="auto-refresh-select" class="form-select form-select-sm" style="width: auto;">
                    <option value="0">Disattivato</option>
                    <option value="1" selected>Ogni secondo</option>
                    <option value="10">Ogni 10 secondi</option>
                    <option value="30">Ogni 30 secondi</option>
                    <option value="60">Ogni 1 minuto</option>
                    <option value="300">Ogni 5 minuti</option>
                </select>
            </div>
        </div>

      
            <!-- TAB 1: CUSTOMERS WITH THEIR HOSTS & DATI -->
            <div class="tab-pane fade show active" id="customers-content" role="tabpanel"
                aria-labelledby="customers-tab">
                <% if (!customers || customers.length===0) { %>
                    <div class="alert alert-warning">Nessun cliente trovato nel sistema.</div>
                    <% } else { %>
                        <% customers.forEach((customer)=> { %>
                            <%- include('partials/customer-card', { customer: customer }) %>
                                <% }); %>
                                    <% } %>
            </div>
    </div>

</body>

</html>