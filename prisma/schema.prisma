generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model customers {
  tokenI      String  @id
  name        String  @default("new-entry?")
  lastUpdates String?
  builds      Bytes?
  dati        dati[]
  hosts       hosts[]
}

model dati {
  serial          String
  datainfo        String?
  dataconsumabili Bytes?
  datacontatori   String?
  dataalerts      Bytes?
  token           String
  data            Bytes?
  lastUpdates     String?
  customers       customers @relation(fields: [token], references: [tokenI])

  @@unique([serial, token])
}

model hosts {
  hostname   String?
  token      String    @unique(map: "sqlite_autoindex_hosts_1")
  options    Bytes?
  IPV4       String?
  crawler    String?
  customerID String    @default("none-error")
  knownhosts Bytes?
  customers  customers @relation(fields: [customerID], references: [tokenI])
}

model oids {
  oid         String
  brandShort  String?
  vendoroid   String?
  descrizione String?
  short       String?
  priority    Int     @default(-1)
  mode        Int?    @default(0)
  id          Int     @id @unique(map: "sqlite_autoindex_oids_1") @default(autoincrement())
}
