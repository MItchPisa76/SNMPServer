generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

model customer {
  tokenI String @unique(map: "sqlite_autoindex_customer_1")
  name   String
  id     Int    @id @unique(map: "sqlite_autoindex_customer_2") @default(autoincrement())
}

model dati {
  serial          String  @id
  datainfo        String?
  dataconsumabili Bytes?
  datacontatori   String?
  dataalerts      Bytes?
  token           String
  data            Bytes?
  hosts           hosts   @relation(fields: [token], references: [token])
}

model hosts {
  hostname   String?
  token      String  @unique(map: "sqlite_autoindex_hosts_1")
  options    Bytes?
  IPV4       String?
  crawler    String?
  customerID String
  dati       dati[]
}

model oids {
  oid         String
  brandShort  String?
  vendoroid   String?
  descrizione String?
  short       String?
  priority    Int     @default(-1)
  mode        Int?    @default(0)
  id          Int     @id @unique(map: "sqlite_autoindex_oids_1") @default(autoincrement())
}
